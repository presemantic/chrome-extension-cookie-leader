{
  "manifest_version": 3,
  "name": "Header Leader - HTTP Cookies Editor",
  "version": "0.1.9",
  "description": "View, add, edit, and delete cookies matching the active website.",
  "homepage_url": "https://www.presemantic.com/",
  "permissions": [
    "activeTab",
    "cookies"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Header Leader - HTTP Cookies Editor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
